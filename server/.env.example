# Backend Environment Variables (Production & Development)
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=https://your-app.vercel.app

# Optional custom OAuth callback URL base (if different from backend domain)
AUTH_CALLBACK_URL=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# SMTP Email Configuration for Password Reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PROODOS" <noreply@proodos.app>
