# Backend Environment Variables (Production & Development)
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=https://your-app.vercel.app

# Optional custom OAuth callback URL base (if different from backend domain)
AUTH_CALLBACK_URL=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend SMTP Configuration (No custom domain required for testing)
# For Resend without a custom domain:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465 (or 587)
# SMTP_USER=resend
# SMTP_PASS=re_123456789... (Your Resend API Key)
# SMTP_FROM="PROODOS" <onboarding@resend.dev>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="PROODOS" <onboarding@resend.dev>
